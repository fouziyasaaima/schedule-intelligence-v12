# Schedule Intelligence 12.4.0
# -----------------------------------------------------------------------------
# PRMS
PRMS_API_BASE_URL=https://prmscloud.com
PRMS_TOKEN_URL=https://prmscloud.com/api/account/token
PRMS_CLIENT_ID=
PRMS_CLIENT_SECRET=
PRMS_BEARER_TOKEN=
PRMS_TOKEN_CACHE_SECONDS=300

# -----------------------------------------------------------------------------
# MAC — Schedule Intelligence's reasoning engine
# Cost-safe default: Gemini 2.5 Flash-Lite. No AI is called for deterministic
# schedule calculations. MAC is blocked by budget ceilings before a request.
MAC_ENABLED=true
MAC_DEFAULT_PROVIDER=gemini
MAC_DEFAULT_MODEL=gemini-2.5-flash-lite
MAC_DAILY_BUDGET_USD=1.00
MAC_MONTHLY_BUDGET_USD=10.00
MAC_MAX_REQUEST_COST_USD=0.05
MAC_MAX_TOKENS_PER_REQUEST=12000
MAC_REQUIRE_CONFIRMATION_ABOVE_USD=0.02
MAC_CACHE_ENABLED=true
MAC_DATA_POLICY=MINIMAL
MAC_AUTONOMOUS_WATCH=false
MAC_WATCH_INTERVAL_MINUTES=60
MAC_NOTIFY_EMAIL=false

# Provider secrets remain server-side. Never put these in NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Backward-compatible aliases from 12.3.x (MAC settings take precedence).
AI_PROVIDER=gemini
AI_WATCH_ENABLED=false
AI_WATCH_INTERVAL_MINUTES=60
AI_NOTIFY_EMAIL=false

# -----------------------------------------------------------------------------
# Connector security
CONNECTOR_ENCRYPTION_KEY=change-me-to-a-long-random-secret
CONNECTOR_DESTINATION_POLICY=private
CONNECTOR_ALLOWED_PRIVATE_HOSTS=
