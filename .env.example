# Schedule Intelligence 20.3.2 — Docker Multi-App + Integration Hub
# -----------------------------------------------------------------------------
# This package does NOT run Caddy. A separate central Caddy container should
# own ports 80/443 for all applications on the Windows Server.
# For direct testing use docker-compose.testing.yml.
DEPLOY_MODE=local
DOMAIN=localhost
TLS_EMAIL=
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=20.3.2
CADDY_PROXY_NETWORK=caddy_proxy
EMBED_ALLOWED_ORIGINS=*

# Database
POSTGRES_USER=orbital
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=orbital_gantt
POSTGRES_VOLUME_NAME=pg_data

# SMTP (Mailpit is available with: docker compose --profile local up -d)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Schedule Intelligence <no-reply@example.com>
SMTP_REPLY_TO=
EMAIL_BRAND_NAME=Schedule Intelligence
MAILPIT_PORT=8026

# Connector security
CONNECTOR_ENCRYPTION_KEY=replace-with-a-long-random-secret
CONNECTOR_DESTINATION_POLICY=private
CONNECTOR_ALLOWED_PRIVATE_HOSTS=
CONNECTOR_EVENT_WORKER_ENABLED=true
CONNECTOR_EVENT_WORKER_BATCH=25
CONNECTOR_EVENT_MAX_ATTEMPTS=5
CONNECTOR_EVENT_RETRY_BACKOFF_SECONDS=30

# Embedded SI
EMBED_TOKEN_SECRET=replace-with-a-random-32-plus-character-secret
EMBED_APP_URL=http://localhost:3000

# PRMS
PRMS_API_BASE_URL=https://prmscloud.com
PRMS_TOKEN_URL=https://prmscloud.com/api/account/token
PRMS_CLIENT_ID=
PRMS_CLIENT_SECRET=
PRMS_BEARER_TOKEN=
PRMS_TOKEN_CACHE_SECONDS=300

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# MAC / AI
MAC_ENABLED=true
MAC_DEFAULT_PROVIDER=gemini
MAC_DEFAULT_MODEL=gemini-3.5-flash-lite
MAC_DAILY_BUDGET_USD=1.00
MAC_MONTHLY_BUDGET_USD=10.00
MAC_MAX_REQUEST_COST_USD=0.05
MAC_MAX_TOKENS_PER_REQUEST=12000
MAC_REQUIRE_CONFIRMATION_ABOVE_USD=0.02
MAC_CACHE_ENABLED=true
MAC_DATA_POLICY=MINIMAL
MAC_AUTONOMOUS_WATCH=false
MAC_WATCH_INTERVAL_MINUTES=60
MAC_NOTIFY_EMAIL=false
MAC_AUTONOMOUS_SCHEDULING=false
MAC_AUTO_APPLY_DEPENDENCIES=false
MAC_AUTO_OPTIMIZE_DATES=false
MAC_ALLOW_RESOURCE_REASSIGNMENT=false
MAC_CHAT_AUTO_APPLY=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AI_PROVIDER=gemini
AI_WATCH_ENABLED=false
AI_WATCH_INTERVAL_MINUTES=60
AI_NOTIFY_EMAIL=false

# Development seed — keep disabled in production
DEV_SEED=false
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=ChangeMe123!ChangeMe
SCHEDULE_INTELLIGENCE_DEV_API_KEY=
