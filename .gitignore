
# ==========================================
# Schedule Intelligence - Git Ignore
# ==========================================

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example
!.env.template

# -------------------------
# Node.js
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Next.js
# -------------------------
.next/
out/
.vercel/

# -------------------------
# Build / Distribution
# -------------------------
dist/
build/
coverage/

# -------------------------
# TypeScript
# -------------------------
*.tsbuildinfo

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# IDE / Editors
# -------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp
*.swp
*.swo
*~

# -------------------------
# Docker
# -------------------------
docker-compose.override.yml

# -------------------------
# Test / Cache
# -------------------------
.nyc_output/
.eslintcache
.cache/
.parcel-cache/

# -------------------------
# Prisma generated artifacts
# -------------------------
# Keep prisma/schema.prisma and migrations
# Ignore generated Prisma client if present
prisma/generated/

# -------------------------
# Local databases
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# Secrets / certificates
# -------------------------
*.pem
*.key
*.p12
*.pfx
*.crt

# -------------------------
# Uploads / local runtime data
# -------------------------
uploads/
storage/
tmp/
temp/