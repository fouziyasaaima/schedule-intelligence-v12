{
  "name": "orbital-gantt-api",
  "version": "17.4.5",
  "private": true,
  "description": "Standalone, API-first intelligent Gantt scheduling engine with resource planning and Monte Carlo forecasting",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:dedupe-dependencies": "tsx prisma/dedupe-dependencies.ts",
    "create-api-key": "tsx prisma/create-key.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "fastify": "4.28.1",
    "@fastify/cors": "9.0.1",
    "@fastify/sensible": "5.6.0",
    "dotenv": "16.4.5",
    "zod": "3.23.8",
    "@fastify/cookie": "9.4.0",
    "nodemailer": "6.9.16"
  },
  "devDependencies": {
    "prisma": "5.20.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "@types/node": "22.7.4",
    "@types/nodemailer": "6.4.15"
  }
}
