# DigitalOcean / production template
NODE_ENV=production
TRUST_PROXY=true
POSTGRES_PASSWORD=replace-with-a-long-random-secret
APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
DEV_SEED=false
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SCHEDULE_INTELLIGENCE_DEV_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace
SMTP_PASSWORD=replace
SMTP_FROM=Schedule Intelligence <no-reply@example.com>
# Gmail / Google Workspace: smtp.gmail.com, 587, false, with a Google App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=Schedule Intelligence <your-account@gmail.com>
SMTP_REPLY_TO=
EMAIL_BRAND_NAME=Schedule Intelligence
API_BIND=127.0.0.1
UI_BIND=127.0.0.1
API_PORT=4000
UI_PORT=3000
API_INTERNAL_URL=http://api:4000
MAILPIT_PORT=8026

# AES-256-GCM key material for external connector secrets. Use a long random value in production.
CONNECTOR_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Connector network destination policy.
# public = block localhost/RFC1918/link-local destinations (recommended for hosted deployments)
# private = allow self-hosted/private/local APIs (recommended for a trusted on-prem Docker deployment)
# allowlist = allow private/local hosts only when listed in CONNECTOR_ALLOWED_PRIVATE_HOSTS
CONNECTOR_DESTINATION_POLICY=public
CONNECTOR_ALLOWED_PRIVATE_HOSTS=

# PRMS platform-managed authentication
PRMS_API_BASE_URL=https://prmscloud.com
PRMS_TOKEN_URL=https://prmscloud.com/api/account/token
PRMS_CLIENT_ID=PRMS
PRMS_CLIENT_SECRET=replace-with-prms-client-secret
PRMS_BEARER_TOKEN=replace-with-prms-bootstrap-bearer-token
PRMS_TOKEN_CACHE_SECONDS=300

# Optional Google native connector credentials (Web application OAuth client)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
